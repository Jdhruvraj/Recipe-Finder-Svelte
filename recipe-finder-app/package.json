{
  "name": "recipe-finder-app",
  "version": "0.1.0",
  "description": "Recipe Finder & Meal Planner built with SvelteKit + Svelte 5, consuming the recipe-ui-lib StencilJS component library.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  },
  "keywords": [
    "svelte",
    "sveltekit",
    "recipe",
    "meal-planner",
    "stencil",
    "web-components"
  ],
  "license": "MIT",
  "dependencies": {
    "@ssj4kyuubi/recipe-ui-lib": "^0.1.4"
  }
}
